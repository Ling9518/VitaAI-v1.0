# ============================================================
# VitaAI 环境变量配置模板
# 将本文件复制为 .env 并填入真实值（.env 已加入 .gitignore）
# ============================================================

# --- 数据库 ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_hospital?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_db_password

# --- Redis ---
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# --- 邮件（QQ邮箱 SMTP） ---
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_smtp_authorization_code

# --- JWT ---
JWT_SECRET=your_jwt_secret_key_at_least_256_bits

# --- AI 服务 (DeepSeek via Spark proxy) ---
AI_API_KEY=your_ai_api_key
AI_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
AI_MODEL=astron-code-latest
