# ============================================================
# VitaAI 环境变量配置模板
# 将本文件复制为 .env 并填入真实值（.env 已加入 .gitignore）
# ============================================================

# Jasypt 加密主密码（必填，用于解密 application.yml 中的加密值）
JASYPT_ENCRYPTOR_PASSWORD=your_jasypt_master_password

# 加密新值（在 backend 目录下执行）：
# mvn jasypt:encrypt-value -Djasypt.encryptor.password="你的主密码" -Djasypt.plugin.value="要加密的值"
